+struct FixedRun {
+  std::size_t start = 0;
+  std::size_t length = 0;
+};
+
+FixedRun FindLongestFixedRun(const ParsedPattern& pattern) {
+  FixedRun best;
+  FixedRun current;
+
+  for (std::size_t i = 0; i < pattern.mask.size(); ++i) {
+    if (pattern.mask[i]) {
+      if (current.length == 0) {
+        current.start = i;
+      }
+      ++current.length;
+      if (current.length > best.length) {
+        best = current;
+      }
+    } else {
+      current = {};
+    }
+  }
+
+  return best;
+}
+
+bool PatternMatchesAt(const std::vector<std::uint8_t>& buffer, const ParsedPattern& pattern, std::size_t offset) {
+  if (offset + pattern.bytes.size() > buffer.size()) {
+    return false;
+  }
+
+  for (std::size_t i = 0; i < pattern.bytes.size(); ++i) {
+    if (pattern.mask[i] && buffer[offset + i] != pattern.bytes[i]) {
+      return false;
+    }
+  }
+
+  return true;
+}
+
+std::vector<std::size_t> FindPatternMatches(const std::vector<std::uint8_t>& buffer,
+                                            const ParsedPattern& pattern,
+                                            std::size_t max_matches) {
+  std::vector<std::size_t> matches;
+  if (pattern.bytes.empty() || buffer.size() < pattern.bytes.size()) {
+    return matches;
+  }
+
+  const std::size_t scan_end = buffer.size() - pattern.bytes.size();
+  for (std::size_t i = 0; i <= scan_end; ++i) {
+    if (PatternMatchesAt(buffer, pattern, i)) {
+      matches.push_back(i);
+      if (matches.size() >= max_matches) {
+        break;
+      }
+    }
+  }
+
+  return matches;
+}
+
+std::string FormatBytes(const std::vector<std::uint8_t>& bytes, std::size_t start, std::size_t length) {
+  std::ostringstream out;
+  out << std::uppercase << std::hex << std::setfill('0');
+  for (std::size_t i = 0; i < length; ++i) {
+    if (i != 0) {
+      out << ' ';
+    }
+    out << std::setw(2) << static_cast<unsigned>(bytes[start + i]);
+  }
+  return out.str();
+}
+
+std::string FormatBytes(const std::uint8_t* bytes, std::size_t length) {
+  std::ostringstream out;
+  out << std::uppercase << std::hex << std::setfill('0');
+  for (std::size_t i = 0; i < length; ++i) {
+    if (i != 0) {
+      out << ' ';
+    }
+    out << std::setw(2) << static_cast<unsigned>(bytes[i]);
+  }
+  return out.str();
+}
+
+std::vector<std::size_t> FindFixedRunCandidates(const std::vector<std::uint8_t>& buffer,
+                                                const ParsedPattern& pattern,
+                                                FixedRun run,
+                                                std::size_t max_candidates) {
+  std::vector<std::size_t> candidates;
+  if (run.length == 0 || buffer.size() < run.length) {
+    return candidates;
+  }
+
+  for (std::size_t i = 0; i + run.length <= buffer.size(); ++i) {
+    if (std::memcmp(buffer.data() + i, pattern.bytes.data() + run.start, run.length) == 0) {
+      candidates.push_back(i);
+      if (candidates.size() >= max_candidates) {
+        break;
+      }
+    }
+  }
+
+  return candidates;
+}
+
+bool IsAddressInModule(std::uintptr_t address, std::uintptr_t module_base, std::size_t module_size) {
+  return address >= module_base && address < module_base + module_size;
+}
+
+bool IsRvaInExecutableSection(std::uint32_t rva, const std::vector<SectionInfo>& sections) {
+  for (const auto& section : sections) {
+    const auto section_start = section.virtual_address;
+    const auto section_end = section.virtual_address + section.virtual_size;
+    if (rva >= section_start && rva < section_end) {
+      return (section.characteristics & IMAGE_SCN_MEM_EXECUTE) != 0;
+    }
+  }
+
+  return false;
+}
+
+SignatureMatchDiagnostic BuildMatchDiagnostic(const ParsedPattern& pattern,
+                                              OffsetType offset_type,
+                                              const std::vector<std::uint8_t>& buffer,
+                                              std::uintptr_t module_base,
+                                              std::size_t module_size,
+                                              std::size_t match,
+                                              bool accepted) {
+  void* resolved = reinterpret_cast<void*>(module_base + match);
+  if (pattern.has_offset_marker) {
+    resolved = PatternScanner::ResolveOffset(module_base + match,
+                                             pattern.offset_position,
+                                             offset_type,
+                                             buffer.data() + match);
+  }
+
+  const auto resolved_addr = reinterpret_cast<std::uintptr_t>(resolved);
+  return {
+      static_cast<std::uint64_t>(match),
+      static_cast<std::uint64_t>(resolved_addr - module_base),
+      IsAddressInModule(resolved_addr, module_base, module_size),
+      accepted,
+  };
+}
+
+void LogExactMatch(const char* name,
+                   const ParsedPattern& pattern,
+                   OffsetType offset_type,
+                   const std::vector<std::uint8_t>& buffer,
+                   std::uintptr_t module_base,
+                   std::size_t module_size,
+                   std::size_t match) {
+  void* resolved = reinterpret_cast<void*>(module_base + match);
+  if (pattern.has_offset_marker) {
+    resolved = PatternScanner::ResolveOffset(module_base + match,
+                                             pattern.offset_position,
+                                             offset_type,
+                                             buffer.data() + match);
+  }
+
+  const auto resolved_addr = reinterpret_cast<std::uintptr_t>(resolved);
+  const bool in_image = IsAddressInModule(resolved_addr, module_base, module_size);
+  const auto resolved_rva = static_cast<std::uint32_t>(resolved_addr - module_base);
+
+  constexpr std::size_t kContextBytes = 48;
+  const std::size_t context_start = match > kContextBytes ? match - kContextBytes : 0;
+  const std::size_t context_end = std::min(buffer.size(), match + pattern.bytes.size() + kContextBytes);
+  const std::size_t context_length = context_end - context_start;
+
+  PIPE_LOG_WARN("[PatternScanner]   {} exact match RVA=0x{:08X} VA={:p} resolved RVA=0x{:08X} in_image={}",
+                name,
+                static_cast<std::uint32_t>(match),
+                reinterpret_cast<void*>(module_base + match),
+                resolved_rva,
+                in_image ? "yes" : "no");
+  PIPE_LOG_DEBUG("[PatternScanner]   {} exact context RVA=0x{:08X} match_offset={} bytes={}",
+                 name,
+                 static_cast<std::uint32_t>(context_start),
+                 match - context_start,
+                 FormatBytes(buffer.data() + context_start, context_length));
+}
+
+void LogMissingPatternDiagnostics(const char* name,
+                                  const ParsedPattern& pattern,
+                                  OffsetType offset_type,
+                                  const std::vector<std::uint8_t>& buffer,
+                                  std::uintptr_t module_base,
+                                  std::size_t module_size) {
+  FixedRun run = FindLongestFixedRun(pattern);
+  if (run.length < 3) {
+    PIPE_LOG_DEBUG("[PatternScanner] Diagnostic {}: no useful fixed anchor in pattern", name);
+    return;
+  }
+
+  const std::size_t kMaxCandidates = run.length >= 4 ? 5 : 3;
+  std::vector<std::size_t> candidates = FindFixedRunCandidates(buffer, pattern, run, kMaxCandidates);
+  std::string anchor = FormatBytes(pattern.bytes, run.start, run.length);
+
+  if (candidates.empty()) {
+    PIPE_LOG_DEBUG("[PatternScanner] Diagnostic {}: longest anchor not found (offset={}, bytes={})",
+                   name,
+                   run.start,
+                   anchor);
+    return;
+  }
+
+  PIPE_LOG_DEBUG("[PatternScanner] Diagnostic {}: longest anchor matched {}{} time(s) (offset={}, bytes={})",
+                 name,
+                 candidates.size(),
+                 candidates.size() == kMaxCandidates ? "+" : "",
+                 run.start,
+                 anchor);
+  if (run.length == 3) {
+    PIPE_LOG_DEBUG("[PatternScanner] Diagnostic {}: weak 3-byte anchor only; candidate list is exploratory", name);
+  }
+  for (std::size_t candidate : candidates) {
+    constexpr std::size_t kContextBytes = 48;
+    const std::size_t context_start = candidate > kContextBytes ? candidate - kContextBytes : 0;
+    const std::size_t context_end = std::min(buffer.size(), candidate + run.length + kContextBytes);
+    const std::size_t context_length = context_end - context_start;
+
+    PIPE_LOG_DEBUG("[PatternScanner] Diagnostic {}: anchor candidate RVA=0x{:08X} VA={:p}",
+                   name,
+                   static_cast<std::uint32_t>(candidate),
+                   reinterpret_cast<void*>(module_base + candidate));
+    PIPE_LOG_DEBUG("[PatternScanner] Diagnostic {}: context RVA=0x{:08X} anchor_offset={} bytes={}",
+                   name,
+                   static_cast<std::uint32_t>(context_start),
+                   candidate - context_start,
+                   FormatBytes(buffer.data() + context_start, context_length));
+
+    if (pattern.has_offset_marker && candidate >= run.start) {
+      const std::size_t candidate_pattern_start = candidate - run.start;
+      if (candidate_pattern_start + pattern.bytes.size() <= buffer.size()) {
+        void* resolved = PatternScanner::ResolveOffset(module_base + candidate_pattern_start,
+                                                       pattern.offset_position,
+                                                       offset_type,
+                                                       buffer.data() + candidate_pattern_start);
+        const auto resolved_addr = reinterpret_cast<std::uintptr_t>(resolved);
+        const bool in_image = IsAddressInModule(resolved_addr, module_base, module_size);
+        const auto resolved_rva = static_cast<std::uint32_t>(resolved_addr - module_base);
+        PIPE_LOG_DEBUG("[PatternScanner] Diagnostic {}: candidate pattern-start RVA=0x{:08X}, opcode=0x{:02X}, resolved RVA=0x{:08X}, in_image={}",
+                       name,
+                       static_cast<std::uint32_t>(candidate_pattern_start),
+                       static_cast<unsigned>(buffer[candidate_pattern_start]),
+                       resolved_rva,
+                       in_image ? "yes" : "no");
+      }
+    }
+
+    const std::size_t call_window_start = candidate > 64 ? candidate - 64 : 0;
+    const std::size_t call_window_end = std::min(buffer.size(), candidate + run.length + 64);
+    for (std::size_t call_rva = call_window_start; call_rva + 5 <= call_window_end; ++call_rva) {
+      if (buffer[call_rva] != 0xE8) {
+        continue;
+      }
+
+      void* call_target = PatternScanner::ResolveOffset(module_base + call_rva,
+                                                        1,
+                                                        OffsetType::Relative32Add,
+                                                        buffer.data() + call_rva);
+      const auto target_addr = reinterpret_cast<std::uintptr_t>(call_target);
+      const bool target_in_image = IsAddressInModule(target_addr, module_base, module_size);
+      const auto target_rva = static_cast<std::uint32_t>(target_addr - module_base);
+      const auto delta = static_cast<std::int64_t>(call_rva) - static_cast<std::int64_t>(candidate);
+
+      PIPE_LOG_DEBUG("[PatternScanner] Diagnostic {}: nearby call RVA=0x{:08X}, delta_from_anchor={}, target RVA=0x{:08X}, in_image={}",
+                     name,
+                     static_cast<std::uint32_t>(call_rva),
+                     delta,
+                     target_rva,
+                     target_in_image ? "yes" : "no");
+    }
+  }
+}
